{
  "name": "app-planlang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath githooks",
    "test:watch": "vitest",
    "plan:validar": "tsx scripts/plan-validar.ts",
    "casos:generar": "tsx scripts/casos-generar.ts",
    "brecha:informe": "tsx scripts/brecha-informe.ts",
    "trazas:verificar": "tsx scripts/trazas-verificar.ts",
    "m9:reporte": "tsx scripts/m9-reporte.ts",
    "lote:demo": "agents/.venv/bin/python -m app_agents.lotes --demo a --n 20",
    "lote:base": "agents/.venv/bin/python -m app_agents.lotes --demo a --n 20 --variante agente_unico"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.0.0",
    "next": "16.3.6",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "serve": "14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.10.0"
}
