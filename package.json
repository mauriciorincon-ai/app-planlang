{
  "name": "app-planlang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath githooks",
    "test:watch": "vitest",
    "plan:validar": "tsx scripts/plan-validar.ts",
    "plan:aprobar": "tsx scripts/plan-aprobar.ts",
    "entrevistar": "tsx scripts/entrevistar.ts",
    "casos:generar": "tsx scripts/casos-generar.ts",
    "brecha:informe": "tsx scripts/brecha-informe.ts",
    "trazas:verificar": "tsx scripts/trazas-verificar.ts",
    "m9:reporte": "tsx scripts/m9-reporte.ts",
    "lote:demo": "agents/.venv/bin/python -m app_agents.lotes --demo a --pausa-s 2",
    "lote:base": "agents/.venv/bin/python -m app_agents.lotes --demo a --pausa-s 2 --variante agente_unico",
    "lote:demo-b": "agents/.venv/bin/python -m app_agents.lotes --demo b --pausa-s 2",
    "capturas:maqueta": "node scripts/capturar-maqueta.mjs",
    "capturas:vitrina": "node scripts/capturar-vitrina.mjs",
    "export:verificar": "node scripts/verificar-export.mjs",
    "diagrama:verificar": "tsx scripts/diagrama-igual-grafo.ts",
    "fichas": "tsx --conditions=react-server scripts/fichas.ts",
    "paquete:vitrina": "tsx scripts/paquete-vitrina.ts",
    "paquete:verificar": "tsx scripts/paquete-verificar.ts",
    "test:e2e:paquete": "playwright test -c playwright.paquete.config.ts",
    "tokens": "node scripts/paleta/generar-tokens.mjs",
    "visor:metricas": "tsx scripts/visor/metricas.ts",
    "maqueta": "serve docs -l 3101"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.1.0",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "serve": "14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.10.0"
}
