  "causales_de_exclusion": [
    {
      "id": "a",
      "norma": "Ley Estatutaria 1751 de 2015, art. 15, literal a",
      "resumen": {
        "en": "Its main purpose is cosmetic or luxury, unrelated to recovering or keeping functional or vital capacity.",
        "es": "Su finalidad principal es cosmética o suntuaria, sin relación con recuperar o mantener la capacidad funcional o vital."
      }
    },
    {
      "id": "b",
      "norma": "Ley Estatutaria 1751 de 2015, art. 15, literal b",
      "resumen": {
        "en": "There is no scientific evidence of its safety and clinical efficacy.",
        "es": "No hay evidencia científica sobre su seguridad y eficacia clínica."
      }
    },
    {
      "id": "c",
      "norma": "Ley Estatutaria 1751 de 2015, art. 15, literal c",
      "resumen": {
        "en": "There is no scientific evidence of its clinical effectiveness.",
        "es": "No hay evidencia científica sobre su efectividad clínica."
      }
    },
    {
      "id": "d",
      "norma": "Ley Estatutaria 1751 de 2015, art. 15, literal d",
      "resumen": {
        "en": "Its use is not authorised by the competent authority.",
        "es": "Su uso no está autorizado por la autoridad competente."
      }
    },
    {
      "id": "e",
      "norma": "Ley Estatutaria 1751 de 2015, art. 15, literal e",
      "resumen": {
        "en": "It is at an experimental stage.",
        "es": "Está en fase de experimentación."
      }
    },
    {
      "id": "f",
      "norma": "Ley Estatutaria 1751 de 2015, art. 15, literal f",
      "resumen": {
        "en": "It has to be provided abroad.",
        "es": "Tiene que prestarse en el exterior."
      }
    }
