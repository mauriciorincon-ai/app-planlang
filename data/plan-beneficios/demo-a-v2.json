  "reglas": [
    {
      "id": "RB-01",
      "texto": {
        "en": "Emergency: no authorisation is requested and coverage is not checked; it is approved (Law 1751, art. 14).",
        "es": "Urgencia: no se pide autorización ni se revisa cobertura; se aprueba (Ley 1751, art. 14)."
      }
    },
    {
      "id": "RB-02",
      "texto": {
        "en": "Exempt service: approved without requesting authorisation or checking coverage.",
        "es": "Servicio exento: se aprueba sin pedir autorización ni revisar cobertura."
      }
    },
    {
      "id": "RB-03",
      "texto": {
        "en": "Excluded service: it is denied only by citing its ground under art. 15 of Law 1751, and a person confirms the denial.",
        "es": "Servicio excluido: solo se niega citando su causal del art. 15 de la Ley 1751, y la negación la confirma una persona."
      }
    },
    {
      "id": "RB-04",
      "texto": {
        "en": "High cost: if the estimated cost exceeds the plan's U2 threshold, a human auditor decides.",
        "es": "Alto costo: si el costo estimado supera el umbral U2 del plan, decide un auditor humano."
      }
    },
    {
      "id": "RB-05",
      "texto": {
        "en": "Contradiction: if the order and the doctor's note ask for different procedures, a human auditor decides.",
        "es": "Contradicción: si la orden y el texto del médico piden procedimientos distintos, decide un auditor humano."
      }
    },
    {
      "id": "RB-06",
      "texto": {
        "en": "Doubt about what a service covers: it is resolved in the member's favour (Law 1751, art. 8).",
        "es": "Duda sobre el alcance de un servicio: se resuelve a favor del afiliado (Ley 1751, art. 8)."
      }
    },
    {
      "id": "RB-07",
      "texto": {
        "en": "A plan service that needs authorisation, with complete information and no other condition of this plan: it is approved.",
        "es": "Servicio del plan que requiere autorización, con información completa y sin ninguna otra condición de este plan: se aprueba."
      }
    },
    {
      "id": "RB-08",
      "texto": {
        "en": "Coverage cap: if the estimated cost exceeds what the plan covers for that service, it is approved up to the cap and the excess is denied. It is a partial denial: with Texas mode on, a person decides it.",
        "es": "Tope de cobertura: si el costo estimado supera lo que el plan cubre para ese servicio, se aprueba hasta el tope y el excedente se niega. Es una negación parcial: con el modo Texas encendido, la decide una persona."
      }
    }
  ],
  "tope_alto_costo": "umbral.U2",
  "unidad_de_costo": {
    "en": "synthetic units",
    "es": "unidades sintéticas"
  },
  "version": "2.0.0"
}
