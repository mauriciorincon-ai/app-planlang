# Variables de entorno de la app — copia a .env.local (gitignored) y llena lo que uses.
# Los valores reales JAMÁS se commitean; en Vercel van como env vars del proyecto.

# Sentry (opcional — sin DSN el cliente queda inerte, cero ruido en CI/local):
# NEXT_PUBLIC_SENTRY_DSN=

# Nombre de la app para logs/telemetría (opcional):
# NEXT_PUBLIC_APP_NAME=

# --- Agentes (agents/, Python) — los lee el proceso desde la terminal; NO van a Vercel ---
# Proveedor del modelo (ADR-002): suscripcion (por defecto, binario `claude` con TU sesión, sin clave)
# · simulado (CI y tests) · anthropic · groq (interruptor por clave, solo por decisión del usuario).
# PLANLANG_PROVEEDOR=suscripcion
# Humo real del adaptador (tests/test_adaptador_humo_real.py), solo fuera de CI:
# PLANLANG_HUMO_REAL=1
# Espejo en LangSmith (opcional). La clave se exporta en la terminal con `read -s` (guía de prueba,
# parada 1); nunca se escribe en un archivo del repo. El hijo `claude -p` jamás la recibe.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=planlang-demo-a
