# Renombrar a .gitignore al estampar la app
.claude/settings.local.json
node_modules/
.next/
out/
build/
coverage/
playwright-report/
test-results/
.env
.env.local
.env.*.local
*.tsbuildinfo
.vercel/
.DS_Store
Thumbs.db

# Artefactos de Lighthouse CI al correr `lhci` en local (kit v1.26.0): se colaron en un PR por
# un `git add -A` y disparaban el barrido de CERO ENLACES con falsos positivos del JS del visor.
# Un gate que grita en falso deja de leerse — y ahi se pierde la fuga real.
.lighthouseci/
.lh-*.json

# Perfil python (kit v1.30.0)
agents/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
agents/.coverage
# coverage.py también puede escribir en la raíz (lleva rutas locales: jamás al repo público)
.coverage
.coverage.*
agents/htmlcov/
agents/*.egg-info/
# K2 (planlang S1): `pip install -e` deja el egg-info dentro de src/ (los comentarios de .gitignore van en su línea)
agents/src/*.egg-info/

# planlang S1 — derivados de las corridas de agentes: solo se versiona el JSON exportado (planlang-trace/v1)
runs/**/checkpoints.sqlite
runs/**/*.sqlite-journal
runs/**/*.sqlite-wal
runs/**/*.sqlite-shm

# Paquete de la vitrina para hoja-de-vida (ADR-009): build propio y la carpeta que se copia; se regeneran.
/.next-paquete/
/dist/
