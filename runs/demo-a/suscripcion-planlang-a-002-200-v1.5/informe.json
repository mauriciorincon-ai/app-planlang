        "opcion_elegida": {
          "en": "approve and approve in part; deny and escalate require a human pause; with Texas mode, approving in part does too",
          "es": "aprobar y aprobar en parte; negar y escalar exigen pausa humana; con el modo Texas, también la aprobación en parte"
        },
        "pregunta": {
